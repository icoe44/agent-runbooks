{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Runbook",
  "description": "A verified operational runbook for a GitHub project. All claims must bind an evidence level.",
  "type": "object",
  "required": [
    "schema_version", "repo", "upstream_ref", "goal",
    "environment", "prerequisites", "secrets", "steps",
    "verification", "known_traps", "capabilities", "unknowns",
    "last_verified", "trust"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "repo": {
      "type": "object",
      "required": ["owner", "name"],
      "additionalProperties": false,
      "properties": {
        "owner": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    "upstream_ref": {
      "type": "object",
      "required": ["type", "value"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["tag", "commit", "branch"] },
        "value": { "type": "string" }
      }
    },
    "goal": {
      "type": "object",
      "required": ["id", "description"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "environment": {
      "type": "object",
      "required": ["os", "runtime", "architecture"],
      "additionalProperties": false,
      "properties": {
        "os": {
          "type": "object",
          "required": ["family", "tested"],
          "additionalProperties": false,
          "properties": {
            "family": { "type": "string", "enum": ["linux", "macos", "windows"] },
            "tested": { "type": "array", "items": { "type": "string" } }
          }
        },
        "runtime": { "type": "object", "additionalProperties": true },
        "architecture": { "type": "array", "items": { "type": "string" } }
      }
    },
    "prerequisites": { "type": "array", "items": { "type": "string" } },
    "secrets": {
      "type": "object",
      "required": ["required"],
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "storage", "never_persist"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "storage": { "type": "string" },
              "never_persist": { "type": "boolean" }
            }
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "action"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "action": { "type": "string" },
          "method": { "type": "string" },
          "path": { "type": "string" },
          "payload_example": { "type": "object", "additionalProperties": true },
          "evidence": {
            "type": "object",
            "required": ["type"],
            "additionalProperties": false,
            "properties": {
              "type": { "type": "string", "enum": ["OFFICIAL", "SOURCE", "RUNTIME", "COMMUNITY", "INFERRED", "UNKNOWN"] },
              "source": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "repo": { "type": "string" },
                  "ref": { "type": "string" },
                  "path": { "type": "string" },
                  "lines": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "description"],
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string", "enum": ["api", "runtime", "file", "manual"] },
          "description": { "type": "string" }
        }
      }
    },
    "known_traps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "severity", "evidence"],
        "additionalProperties": false,
        "properties": {
          "description": { "type": "string" },
          "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "evidence": {
            "type": "object",
            "required": ["type"],
            "properties": { "type": { "type": "string", "enum": ["OFFICIAL", "SOURCE", "RUNTIME", "COMMUNITY", "INFERRED", "UNKNOWN"] } }
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "status", "evidence_level"],
        "additionalProperties": false,
        "properties": {
          "claim": { "type": "string" },
          "status": { "type": "string", "enum": ["confirmed", "partially_confirmed", "unsupported_or_unconfirmed"] },
          "evidence_level": { "type": "string", "enum": ["OFFICIAL", "SOURCE", "RUNTIME", "COMMUNITY", "INFERRED", "UNKNOWN"] }
        }
      }
    },
    "unknowns": { "type": "array", "items": { "type": "string" } },
    "last_verified": {
      "type": "object",
      "required": ["at", "execution"],
      "additionalProperties": false,
      "properties": {
        "at": { "type": "string", "format": "date-time" },
        "execution": {
          "type": "object",
          "required": ["result"],
          "additionalProperties": false,
          "properties": {
            "result": { "type": "string", "enum": ["success", "partial", "failed", "not_attempted"] },
            "notes": { "type": "string" }
          }
        }
      }
    },
    "trust": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "enum": ["draft", "community", "verified", "stale"] },
        "risk_level": { "type": "integer", "minimum": 0, "maximum": 3 }
      }
    }
  }
}
